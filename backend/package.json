{
  "name": "@jev/backend",
  "version": "0.1.0",
  "private": true,
  "description": "API server: DigiKey (Product Information V4 + MyLists) and Distrelec (Playwright + Jev judgment) sourcing.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "source": "tsx src/cli.ts",
    "typecheck": "tsc -p . --noEmit",
    "test": "vitest run",
    "install:browsers": "playwright install chromium"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "pino": "^10.3.1",
    "playwright": "^1.63.0"
  },
  "devDependencies": {
    "@jev/shared": "^0.1.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.15",
    "vitest": "^5.0.2"
  }
}

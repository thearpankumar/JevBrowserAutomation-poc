# Jev (via OpenRouter) — see how-to-use-jev.md
OPENROUTER_JEV_API=

# DigiKey Product Information V4 API — https://developer.digikey.com
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=
# NOTE: the developer portal's "Create Production App" flow is the only
# app-creation option available (no separate sandbox app), and the resulting
# credentials only authenticate against the production endpoint
# (sandbox-api.digikey.com returns "Invalid clientId"). Default to false —
# flip to true only if your app was actually issued as a sandbox credential.
DIGIKEY_USE_SANDBOX=false

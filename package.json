{
  "name": "jev-browser-automation-poc",
  "version": "0.1.0",
  "private": true,
  "description": "POC: BOM component sourcing from Distrelec (Playwright + Jev judgment) and DigiKey (Product Information V4 API)",
  "type": "module",
  "scripts": {
    "build": "tsc -p .",
    "source": "tsx src/cli.ts",
    "web": "tsx src/server.ts",
    "install:browsers": "playwright install chromium",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "pino": "^10.3.1",
    "playwright": "^1.47.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^20.14.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.9",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.70.1",
    "vitest": "^2.1.9"
  }
}
